# EVE 增强版配置模板
# 请复制本文件为 .env 并填写你的真实信息

# --- 飞书配置 ---
# 飞书自建应用凭据 (在飞书开放平台获取)
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 接收消息的用户 Open ID (或群 ID)
FEISHU_RECEIVE_ID=ou_xxxxxxxxxxxxxxxx

# --- 大模型配置 (用于情感分析，支持 OpenAI 兼容接口) ---
# 推荐使用：DeepSeek, 阶跃星辰 (Stepfun), 豆包 (Doubao), Moonshot 等
LLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- 录音存储配置 ---
# 统一存储路径：录音、转写、复盘都使用此目录作为根目录
# 支持录音（record）、转写（transcribe）、复盘（review_pipeline）三个模块
EVE_RECORDINGS_DIR=~/eve_recordings
